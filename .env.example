# Copy to .env. Never commit .env.

# Folder holding one shoot: shoot\*.ARW goes inside it. Each person uses their own absolute path.
CULL_ROOT=C:\Users\willp\cull-data\demo

# Leave unset to read CULL_ROOT\work\scores.json.
# Set to run the server on fake data before real scores exist:
# SCORES_PATH=fixtures/fake_scores.json

# Instruction agent. anthropic or presets. Unset: anthropic if a key is set, else presets.
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_AGENT_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=low

# AWS (rekog and taste stages only, being replaced by local models).
# AWS_REGION=us-east-1
# BEDROCK_TASTE_MODEL_ID=

MAX_WORKERS=6
MIN_FACE_WIDTH=0.025
MIN_SHARPNESS=170
